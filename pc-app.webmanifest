{
  "name": "HETEC Sign",
  "short_name": "HETEC Sign",
  "description": "Papierlose Vertragsunterschrift für HETEC Shops",
  "start_url": "./pc-app.html",
  "scope": "./pc-app.html",
  "display": "standalone",
  "background_color": "#1B2430",
  "theme_color": "#1B2430",
  "lang": "de",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./pc-app.html",
      "name": "PDF mit HETEC Sign öffnen",
      "accept": {
        "application/pdf": [".pdf"]
      },
      "icons": [
        { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
}
