rules_version = '2';

// HETEC Sign – Storage Security Rules
//
// Liegt hier NIE im Klartext: original.enc und result.enc sind AES-256-GCM-
// Ciphertext, der Schlüssel existiert ausschließlich im URL-Fragment des
// QR-Codes und wird nie an Firebase übertragen. Diese Regeln verhindern
// zusätzlich, dass FREMDE Nutzer überhaupt an den Ciphertext herankommen.

service firebase.storage {
  match /b/{bucket}/o {
    match /sessions/{sessionId}/original.enc {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.pcUid == request.auth.uid;
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.claimedBy == request.auth.uid;
    }
    match /sessions/{sessionId}/result.enc {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.claimedBy == request.auth.uid;
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.pcUid == request.auth.uid;
    }
    match /sessions/{sessionId}/{allOther=**} {
      allow read, write: if false;
    }
  }
}
